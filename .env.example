# Copy to .env. For Docker Desktop, SQL Server is the Windows host:
# host.docker.internal must point to the enabled, fixed TCP port of SQLEXPRESS.
DATABASE_URL=sqlserver://host.docker.internal:1433;database=GamifiedLearningSystem;user=gls_app;password=CHANGE_ME_SQL_PASSWORD;encrypt=true;trustServerCertificate=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATA_SERVICE_KEY=replace-with-another-random-secret-at-least-32-characters
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Shared local API port, used by both the API and the Vite proxy.
API_PORT=5080
# API_PROXY_TARGET is only needed when proxying to a different host.

# Optional public/LAN settings. Use your real URL and host names when deploying.
PUBLIC_URL=http://localhost:8080
PUBLIC_HOSTS=localhost;127.0.0.1;aspnet-api
# Keep loopback when using a reverse proxy on the same machine.
# Set 0.0.0.0 to allow other devices on your local network to reach port 8080.
FRONTEND_BIND=127.0.0.1
